# The build tree, and a local dist/: copying either in would let a stale local build shadow the one
# this Dockerfile makes -- the exact failure the image removes.
engine/target/
dist/
.git/

# The baselines are trained entries with their own Python toolchain, not an input to this image.
# Excluding them keeps a training edit from re-running the gate, or from reaching the component.
baselines/
